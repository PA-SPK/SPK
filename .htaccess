<IfModule mod_rewrite.c>
    RewriteEngine On
    # Arahkan semua request ke folder public
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Blokir akses ke file konfigurasi sensitif
<FilesMatch "^\.env|composer\.(json|lock)|package\.(json|lock)|artisan">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokir akses langsung ke folder sistem Laravel
RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/
